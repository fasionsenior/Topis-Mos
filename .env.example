# Copy to .env.local for local development with `vercel dev`. Never commit real values.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# Anthropic API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Optional: only accept demo requests from this origin, e.g. https://www.topis.example
ALLOWED_ORIGIN=
